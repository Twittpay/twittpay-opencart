{{ header }}{{ column_left }}
<div id="content">
  <div class="page-header">
    <div class="container-fluid">
      <div class="float-end">
        <button type="submit" form="form-payment" data-bs-toggle="tooltip" title="{{ button_save }}" class="btn btn-primary"><i class="fa-solid fa-floppy-disk"></i></button>
        <a href="{{ back }}" data-bs-toggle="tooltip" title="{{ button_back }}" class="btn btn-light"><i class="fa-solid fa-reply"></i></a>
      </div>
      <h1>{{ heading_title }}</h1>
      <ol class="breadcrumb">
        {% for breadcrumb in breadcrumbs %}
          <li class="breadcrumb-item"><a href="{{ breadcrumb.href }}">{{ breadcrumb.text }}</a></li>
        {% endfor %}
      </ol>
    </div>
  </div>
  <div class="container-fluid">
    <div class="card">
      <div class="card-header"><i class="fa-solid fa-pencil"></i> {{ text_edit }}</div>
      <div class="card-body">
        <form id="form-payment" action="{{ save }}" method="post" data-oc-toggle="ajax">
          <div class="row mb-3">
            <label for="input-display-name" class="col-sm-2 col-form-label">{{ entry_display_name }}</label>
            <div class="col-sm-10">
              <input type="text" name="payment_twittpay_display_name" value="{{ payment_twittpay_display_name }}" id="input-display-name" class="form-control"/>
            </div>
          </div>
          <div class="row mb-3">
            <label for="input-api-key" class="col-sm-2 col-form-label">{{ entry_api_key }}</label>
            <div class="col-sm-10">
              <input type="text" name="payment_twittpay_api_key" value="{{ payment_twittpay_api_key }}" id="input-api-key" class="form-control" autocomplete="off"/>
              <div class="form-text">{{ help_api_key }}</div>
            </div>
          </div>
          <div class="row mb-3">
            <label for="input-usd-rate" class="col-sm-2 col-form-label">{{ entry_usd_rate }}</label>
            <div class="col-sm-10">
              <input type="text" name="payment_twittpay_usd_rate" value="{{ payment_twittpay_usd_rate }}" id="input-usd-rate" class="form-control"/>
              <div class="form-text">{{ help_usd_rate }}</div>
            </div>
          </div>
          <div class="row mb-3">
            <label for="input-completed" class="col-sm-2 col-form-label">{{ entry_completed_status }}</label>
            <div class="col-sm-10">
              <select name="payment_twittpay_completed_status_id" id="input-completed" class="form-select">
                {% for order_status in order_statuses %}
                  <option value="{{ order_status.order_status_id }}"{% if order_status.order_status_id == payment_twittpay_completed_status_id %} selected{% endif %}>{{ order_status.name }}</option>
                {% endfor %}
              </select>
            </div>
          </div>
          <div class="row mb-3">
            <label for="input-pending" class="col-sm-2 col-form-label">{{ entry_pending_status }}</label>
            <div class="col-sm-10">
              <select name="payment_twittpay_pending_status_id" id="input-pending" class="form-select">
                {% for order_status in order_statuses %}
                  <option value="{{ order_status.order_status_id }}"{% if order_status.order_status_id == payment_twittpay_pending_status_id %} selected{% endif %}>{{ order_status.name }}</option>
                {% endfor %}
              </select>
            </div>
          </div>
          <div class="row mb-3">
            <label for="input-sort-order" class="col-sm-2 col-form-label">{{ entry_sort_order }}</label>
            <div class="col-sm-10">
              <input type="text" name="payment_twittpay_sort_order" value="{{ payment_twittpay_sort_order }}" id="input-sort-order" class="form-control"/>
            </div>
          </div>
          <div class="row mb-3">
            <label class="col-sm-2 col-form-label">{{ entry_status }}</label>
            <div class="col-sm-10">
              <div class="form-check form-switch form-switch-lg">
                <input type="hidden" name="payment_twittpay_status" value="0"/>
                <input type="checkbox" name="payment_twittpay_status" value="1" id="input-status" class="form-check-input"{% if payment_twittpay_status %} checked{% endif %}/>
              </div>
            </div>
          </div>
        </form>
      </div>
    </div>
  </div>
</div>
{{ footer }}
